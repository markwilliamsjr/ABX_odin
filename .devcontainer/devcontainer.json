{
    "name": "ABX Odin",

    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

    "features": {
        "ghcr.io/devcontainers/features/git:1": {}
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "DanielGavin.ols"
            ],
            "settings": {
                "files.associations": {
                    "*.odin": "odin"
                },
                "ols.updates.askBeforeDownload": false,
                "ols.server.path": "/opt/ols/ols"
            }
        }
    },

    "postCreateCommand": "bash .devcontainer/setup.sh"
}
